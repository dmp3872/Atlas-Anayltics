# Copy to .env and fill in from Supabase Dashboard → Project Settings → API
# Run migrations in supabase/migrations/ against your project (Supabase CLI or SQL editor).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Needed to seed test logins: node scripts/seed-role-test-accounts.mjs
# Also required on Vercel for Additional COA ($50) checkout (api/clone-coa-for-brand)
# and recommended for api/confirm-order-payment.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe card payments (Payment Element). Publishable key is exposed to the browser.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
# Server-only secret or restricted key (needs PaymentIntents read/write). Never prefix with VITE_.
STRIPE_SECRET_KEY=sk_or_rk_...

# Comma-separated emails that get admin access in the UI (optional fallback if DB role not set)
VITE_ADMIN_EMAILS=you@example.com
